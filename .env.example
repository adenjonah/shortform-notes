# Everything here is optional. shortform-notes picks the first available backend in this order:
#
#   summary     OPENAI_API_KEY, then ANTHROPIC_API_KEY, then `claude` on PATH, then `codex` on PATH, else none
#   transcript  OPENAI_API_KEY, then faster-whisper if installed (pip install "shortform-notes[local]"), else none
#
# Override the auto-detection with the *_PROVIDER variables or the --summary / --transcribe flags.

# Option A: your own API key
OPENAI_API_KEY=            # transcription (gpt-4o-mini-transcribe) + summaries (gpt-4o-mini)
ANTHROPIC_API_KEY=         # summaries with Claude (claude-opus-5)

# Option B: no key, using an installed coding-agent CLI
# Nothing to set. If `claude` (Claude Code) or `codex` (OpenAI Codex CLI) is on your PATH
# and logged in, summaries run through it. Pin one explicitly if both are installed:
SHORTFORM_NOTES_SUMMARY_PROVIDER=        # openai | anthropic | claude-code | codex | none | auto
SHORTFORM_NOTES_CLAUDE_CODE_MODEL=       # optional, e.g. sonnet / opus / haiku (default: the CLI's default)
SHORTFORM_NOTES_CODEX_MODEL=             # optional (default: the CLI's default)

# Transcription
SHORTFORM_NOTES_TRANSCRIBE_PROVIDER=     # openai | local | none | auto
SHORTFORM_NOTES_WHISPER_MODEL=base       # local only: tiny | base | small | medium | large-v3

# Output
SHORTFORM_NOTES_DIR=reels                # point at your vault, e.g. ~/notes/reels
SHORTFORM_NOTES_AUDIENCE=the reader      # who the summary is written for, e.g. "Jonah, a home cook"

# On-screen text (OCR). Off by default. Downloads the full video and reads sampled frames.
SHORTFORM_NOTES_OCR=0              # 1 to turn on
SHORTFORM_NOTES_OCR_PROVIDER=      # local (free) | openai | anthropic | auto
SHORTFORM_NOTES_OCR_FPS=1          # frames per second to read; 0 = every frame (about 30x the cost on a paid backend)
SHORTFORM_NOTES_OCR_OPENAI_MODEL=gpt-4o-mini
SHORTFORM_NOTES_OCR_ANTHROPIC_MODEL=claude-opus-5
