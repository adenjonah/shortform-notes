# All optional. With nothing set, reelnotes writes a caption + metadata note.

# Transcription (OpenAI gpt-4o-mini-transcribe, ~$0.003/min) and default summaries.
OPENAI_API_KEY=

# Summaries with Claude instead (transcription still needs OPENAI_API_KEY).
ANTHROPIC_API_KEY=

# Where notes go. Point this at your Obsidian vault, e.g. ~/notes/reels
REELNOTES_DIR=reels

# openai | anthropic | none  (default: auto — openai if its key is set, else anthropic, else none)
REELNOTES_SUMMARY_PROVIDER=

# Who the note is written for; shapes the summary prompt. e.g. "Jonah, a home cook"
REELNOTES_AUDIENCE=the reader

# Set to 0 to never download audio (caption-only, faster, free)
REELNOTES_TRANSCRIBE=1
