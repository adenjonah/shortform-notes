# Everything here is optional. reelnotes auto-detects the best backend it can find:
#
#   summary     OPENAI_API_KEY → ANTHROPIC_API_KEY → `claude` on PATH → `codex` on PATH → none
#   transcript  OPENAI_API_KEY → faster-whisper installed (pip install "reelnotes[local]") → none
#
# Override the auto-detection with the *_PROVIDER variables or the --summary / --transcribe flags.

# ── Option A: bring your own API key ──────────────────────────────────
OPENAI_API_KEY=            # transcription (gpt-4o-mini-transcribe) + summaries (gpt-4o-mini)
ANTHROPIC_API_KEY=         # summaries with Claude (claude-opus-5)

# ── Option B: no key — use the coding agent you already pay for ───────
# Nothing to set. If `claude` (Claude Code) or `codex` (OpenAI Codex CLI) is on your PATH
# and logged in, summaries run through it. Pin one explicitly if you have both:
REELNOTES_SUMMARY_PROVIDER=        # openai | anthropic | claude-code | codex | none | auto
REELNOTES_CLAUDE_CODE_MODEL=       # optional, e.g. sonnet / opus / haiku (default: the CLI's default)
REELNOTES_CODEX_MODEL=             # optional (default: the CLI's default)

# ── Transcription ─────────────────────────────────────────────────────
REELNOTES_TRANSCRIBE_PROVIDER=     # openai | local | none | auto
REELNOTES_WHISPER_MODEL=base       # local only: tiny | base | small | medium | large-v3

# ── Output ────────────────────────────────────────────────────────────
REELNOTES_DIR=reels                # point at your vault, e.g. ~/notes/reels
REELNOTES_AUDIENCE=the reader      # who the summary is written for, e.g. "Jonah, a home cook"
